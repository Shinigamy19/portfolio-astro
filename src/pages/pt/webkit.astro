import WebkitSection from "../../components/sections/Webkit.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("webkit.title")} description={t("webkit.description")}>

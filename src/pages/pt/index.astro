---
import Layout from "../../layouts/Layout.astro";

import SectionContainer from "../../components/ui/SectionContainer.astro";
import TitleSection from "../../components/ui/TitleSection.astro";
import Presentacion from "../../components/sections/Presentacion.astro";
import Experiencia from "../../components/sections/Experiencia.astro";
import Proyectos from "../../components/sections/Proyectos.astro";
import SobreMi from "../../components/sections/SobreMi.astro";

import CodeIcon from "../../components/icons/CodeIcon.astro";
import MaletaIcon from "../../components/icons/MaletaIcon.astro";
import ProfileIcon from "../../components/icons/ProfileIcon.astro";
import ContactoIcon from "../../components/icons/ContactoIcon.astro";
import Contacto from "../../components/sections/Contacto.astro";
import Habilidades from "../../components/sections/Habilidades.astro";
import SkillsIcon from "../../components/icons/SkillsIcon.astro";
import Educacion from "../../components/sections/Educacion.astro";
import EducacionIcon from "../../components/icons/EducacionIcon.astro";
---

<Layout
  title="Portfolio Shinigamy19 - Full-Stack Developer & Designer UX/UI"
  description="Sou Eros (Shinigamy19). Desenvolvedor Full-Stack, Designer Multimídia e Criador de Conteúdo. Transformo ideias em aplicações web criativas."
>
  <main class="px-4">
    <SectionContainer class="pt-28 pb-16 md:py-36">
      <Presentacion />
    </SectionContainer>
  </main>

  <div class="space-y-24">
    <SectionContainer id="experiencia" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <MaletaIcon class="size 8" />
        Experiência Profissional
      </TitleSection>
      <Experiencia />
    </SectionContainer>

    <SectionContainer id="proyectos" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <CodeIcon class="size-7" />
        Projetos
      </TitleSection>
      <Proyectos />
    </SectionContainer>

    <SectionContainer id="sobre-mi" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <ProfileIcon class="size-8" />
        Sobre mim
      </TitleSection>
      <SobreMi />
    </SectionContainer>

    <SectionContainer id="habilidades" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <SkillsIcon class="size-8" />
        Habilidades
      </TitleSection>
      <Habilidades />
    </SectionContainer>

    <SectionContainer id="educacion" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <EducacionIcon class="size-8" />
        Educação
      </TitleSection>
      <Educacion />
    </SectionContainer>

    <SectionContainer id="contacto" maxWidth="lg:max-w-6xl md:max-w-4xl">
      <TitleSection>
        <ContactoIcon class="size-8" />
        Contato
      </TitleSection>
      <Contacto />
    </SectionContainer>
  </div>
</Layout>

---
const SKILLS = [
    {
        category: "Lenguajes de Programación",
        items: [
            "HTML5",
            "CSS3",
            "JavaScript",
            "Python",
            "PHP",
            "Java",
            "C/C++",
            "C#",
            "Kotlin",
            "GML",
            "JSON",
            "MySQL",
        ],
    },
    {
        category: "Diseño & Edición",
        items: [
            "Photoshop",
            "Illustrator",
            "InDesign",
            "After Effects",
            "Premiere Pro",
            "Audition",
            "Blender",
            "Aseprite",
        ],
    },
    {
        category: "Desarrollo & Herramientas",
        items: [
            "Figma",
            "Godot",
            "Visual Studio",
            "Android Studio",
            "Docker",
            "Arduino",
            "AutoCAD",
            "Excel",
            "Word",
            "PowerPoint",
        ],
    },
    {
        category: "Idiomas & Soft Skills",
        items: [
            "Español (Nativo)",
            "Portugués (Nativo)",
            "Inglés (Básico)",
            "Community Management",
            "Autodidacta",
            "Proactivo",
        ],
    },
];

const ACHIEVEMENTS = [
    {
        title: 'Premio Innovación: "Remediación Nativa" en OlimpíADA del Agua',
        icon: "trophy",
        color: "text-yellow-500",
    },
    {
        title: 'Creador de "End Of Bioworld" - juego de plataformas 2D',
        icon: "controller",
        color: "text-purple-500",
    },
    {
        title: 'Editor de "Inmortal" y "El Amanecer de la Tormenta"',
        icon: "book",
        color: "text-teal-400",
    },
    {
        title: 'Creador de "Break Friends" - juego de mesa',
        icon: "dice",
        color: "text-white",
    },
];
---

<div class="flex flex-col gap-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
            SKILLS.map((skillGroup) => (
                <div class="bg-white/80 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 hover:border-purple-400 dark:hover:border-gray-600 transition-colors shadow-sm">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
                        {skillGroup.category}
                    </h3>
                    <div class="flex flex-wrap gap-3">
                        {skillGroup.items.map((item) => (
                            <span class="bg-[#582f82] dark:bg-[#582f82] text-white text-xs font-semibold px-4 py-1.5 rounded-full shadow-sm hover:scale-105 transition-transform cursor-default">
                                {item}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>

    <div
        class="bg-gradient-to-br from-purple-50 to-blue-50 dark:bg-none dark:bg-[#0f172a] border border-purple-200 dark:border-blue-900/30 rounded-2xl p-8 relative overflow-hidden group"
    >
        <div
            class="absolute inset-0 bg-gradient-to-br from-purple-100/50 via-transparent to-blue-100/50 dark:from-blue-900/10 dark:via-transparent dark:to-purple-900/10 pointer-events-none group-hover:from-purple-200/60 dark:group-hover:from-blue-900/20 transition-all duration-500"
        >
        </div>
        <h3
            class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center relative z-10"
        >
            Logros Destacados
        </h3>

        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 relative z-10"
        >
            {
                ACHIEVEMENTS.map((achievement) => (
                    <div class="flex items-start gap-4 p-3 rounded-xl hover:bg-purple-100/50 dark:hover:bg-white/5 transition-colors border border-transparent hover:border-purple-200 dark:hover:border-white/10">
                        <div class={`shrink-0 mt-1 ${achievement.color}`}>
                            {achievement.icon === "trophy" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="icon icon-tabler icon-tabler-trophy"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        stroke="none"
                                        d="M0 0h24v24H0z"
                                        fill="none"
                                    />
                                    <path d="M8 21l8 0" />
                                    <path d="M12 17l0 4" />
                                    <path d="M7 4l10 0" />
                                    <path d="M17 4v8a5 5 0 0 1 -10 0v-8" />
                                    <path d="M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                    <path d="M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                </svg>
                            )}
                            {achievement.icon === "controller" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="icon icon-tabler icon-tabler-device-gamepad-2"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        stroke="none"
                                        d="M0 0h24v24H0z"
                                        fill="none"
                                    />
                                    <path d="M12 5h3.5a5 5 0 0 1 0 10h-5.5l-4.015 4.227a2.3 2.3 0 0 1 -3.923 -2.035l1.634 -8.173a5 5 0 0 1 4.904 -4.019h3.4z" />
                                    <path d="M14 15l4.07 4.284a2.3 2.3 0 0 0 3.925 -2.023l-1.6 -8.232" />
                                    <path d="M8 9v2" />
                                    <path d="M7 10h2" />
                                    <path d="M14 10h2" />
                                </svg>
                            )}
                            {achievement.icon === "book" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="icon icon-tabler icon-tabler-books"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        stroke="none"
                                        d="M0 0h24v24H0z"
                                        fill="none"
                                    />
                                    <path d="M5 4m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z" />
                                    <path d="M9 4m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z" />
                                    <path d="M5 8h4" />
                                    <path d="M9 16h4" />
                                    <path d="M13.803 4.56l2.184 -.537a1 1 0 0 1 1.215 .733l1.48 5.823a1 1 0 0 1 -.733 1.215l-2.185 .537a1 1 0 0 1 -1.215 -.733l-1.48 -5.823a1 1 0 0 1 .733 -1.215z" />
                                    <path d="M14 9l4 -1" />
                                </svg>
                            )}
                            {achievement.icon === "dice" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="icon icon-tabler icon-tabler-dice"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        stroke="none"
                                        d="M0 0h24v24H0z"
                                        fill="none"
                                    />
                                    <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" />
                                    <circle
                                        cx="8.5"
                                        cy="8.5"
                                        r=".5"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="15.5"
                                        cy="8.5"
                                        r=".5"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="15.5"
                                        cy="15.5"
                                        r=".5"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="8.5"
                                        cy="15.5"
                                        r=".5"
                                        fill="currentColor"
                                    />
                                </svg>
                            )}
                        </div>
                        <p class="text-gray-700 dark:text-gray-300 text-base leading-relaxed">
                            {achievement.title}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</div>

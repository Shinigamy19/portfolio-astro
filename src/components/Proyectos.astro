---
import GitHubIcon from "./icons/GithubIcon.astro";
import NextJSIcon from "./icons/NextJSIcon.astro";
import TailwindIcon from "./icons/TailwindIcon.astro";
import LinkButtonIcon from "./LinkButton.astro";
import ProcessingIcon from "./icons/ProcessingIcon.astro";
import PuredataIcon from "./icons/PuredataIcon.astro";
import JavaIcon from "./icons/JavaIcon.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJSIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: TailwindIcon,
  },
  JAVA: {
    name: "Java",
    class: "bg-orange-900 text-white",
    icon: JavaIcon,
  },
  PROCESSING: {
    name: "Processing",
    class: "bg-[#003159] text-white",
    icon: ProcessingIcon,
  },
  PUREDATA: {
    name: "Pure Data",
    class: "bg-gray-100 text-black",
    icon: PuredataIcon,
  },
  PHOTOSHOP: {
    name: "Photoshop",
    class: "bg-[#31A8FF] text-white",
    // icon: PhotoshopIcon, // Add icon if available, otherwise just text
  },
  ILLUSTRATOR: {
    name: "Illustrator",
    class: "bg-[#FF9A00] text-black",
  },
  INDESIGN: {
    name: "InDesign",
    class: "bg-[#FF3366] text-white",
  },
  PREMIERE: {
    name: "Premiere Pro",
    class: "bg-[#9999FF] text-white",
  },
  AFTER: {
    name: "After Effects",
    class: "bg-[#9999FF] text-white",
  },
  UNITY: {
    name: "Unity",
    class: "bg-black text-white",
  },
  CSHARP: {
    name: "C#",
    class: "bg-green-600 text-white",
  },
  WORDPRESS: {
    name: "WordPress",
    class: "bg-[#21759b] text-white",
  },
};

const PROJECTS = [
  {
    title: "Una conversacion con El Roles",
    description:
      "Novela visual y Aventura conversacional realizada en processing.",
    image: "Uccer.webp",
    tags: [TAGS.JAVA, TAGS.PROCESSING],
    category: "Videojuegos",
  },
  {
    title: "Centro de procesamiento de audio",
    description:
      "Programa para procesar audio, con vsts, efectos, filtros y pedales.",
    image: "Pedales.webp",
    tags: [TAGS.PUREDATA],
    category: "Audiovisual",
  },
  {
    title: "Inmortal - Libro de Poemas",
    description:
      "Edición y diseño editorial completo de libro de poemas. Maquetación, ilustraciones y diseño de portada.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/1400/220268106950343.5f9bc1d528994.jpg", // Placeholder or upload
    tags: [TAGS.INDESIGN, TAGS.PHOTOSHOP],
    category: "Editorial",
  },
  {
    title: "Break Friends - Juego de Mesa",
    description:
      "Creación integral de juego de mesa: diseño de cartas, tablero, manual de reglas y empaquetado.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/1400/f35602106950343.5f9bc1d529241.jpg", // Placeholder
    tags: [TAGS.ILLUSTRATOR, TAGS.PHOTOSHOP],
    category: "Producto",
  },
  {
    title: "End Of Bioworld - Juego 2D",
    description:
      "Desarrollo completo de videojuego de plataformas 2D. Diseño de personajes, niveles y mecánicas de juego.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/fs/8c7295106950343.5f9bc1d5299da.png", // Placeholder
    tags: [TAGS.UNITY, TAGS.CSHARP],
    category: "Videojuegos",
  },
  {
    title: "Content Creation - TeamTube",
    description:
      "Edición de video y audio profesional, generación de thumbnails y contenido optimizado para redes sociales.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/disp/313333106950343.5f9bc1d52a23e.png", // Placeholder
    tags: [TAGS.PREMIERE, TAGS.AFTER],
    category: "Audiovisual",
  },
  {
    title: "Desarrollo Web - Compuservice",
    description:
      "Diseño y desarrollo de sitios web responsivos para clientes, optimización SEO y mantenimiento.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/disp/d4d0ec106950343.5f9bc1d52a818.png", // Placeholder
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.WORDPRESS],
    category: "Web",
  },
  {
    title: "Remediación Nativa",
    description:
      "Proyecto ganador del premio innovación en OlimpiADA del Agua. Diseño de campaña y materiales comunicacionales.",
    image:
      "https://mir-s3-cdn-cf.behance.net/project_modules/disp/5b6342106950343.5f9bc1d52ac4d.png", // Placeholder
    tags: [TAGS.PHOTOSHOP, TAGS.ILLUSTRATOR],
    category: "Gráfico",
  },
];

const CATEGORIES = [
  "Todos",
  "Editorial",
  "Producto",
  "Videojuegos",
  "Audiovisual",
  "Web",
  "Gráfico",
];
---

<div class="flex flex-col items-center gap-y-8 w-full">
  <!-- Category Tabs -->
  <div class="flex flex-wrap justify-center gap-4 mb-8">
    {
      CATEGORIES.map((category) => (
        <button
          class="category-btn px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 border border-gray-600 dark:border-gray-600 bg-transparent text-gray-800 dark:text-white hover:bg-blue-600 hover:text-white hover:border-blue-600 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:border-blue-600"
          data-category={category}
          data-active={category === "Todos"}
        >
          {category}
        </button>
      ))
    }
  </div>

  <!-- Projects Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full"
    id="projects-grid"
  >
    {
      PROJECTS.map(({ image, title, description, tags, category }) => (
        <article
          class="project-card group relative flex flex-col bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          data-category={category}
        >
          <div class="relative h-48 overflow-hidden">
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300 z-10" />
            <img
              alt={title}
              class="object-cover object-center w-full h-full transform transition-transform duration-500 group-hover:scale-110"
              src={image || "/placeholder-project.jpg"}
              loading="lazy"
            />
          </div>

          <div class="flex flex-col flex-1 p-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
              {title}
            </h3>

            <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm line-clamp-3 flex-1">
              {description}
            </p>

            <div class="flex flex-wrap gap-2 mt-auto">
              {tags.map((tag) => (
                <span
                  class={`flex items-center gap-x-1.5 rounded-full text-xs font-medium px-2.5 py-1 ${tag.class}`}
                >
                  {tag.icon && <tag.icon class="size-3.5" />}
                  {tag.name}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-4 flex gap-4">
    <button
      id="projects-load-more"
      class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      Ver más proyectos
    </button>
    <button
      id="projects-show-less"
      class="hidden bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      Ver menos
    </button>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll(".category-btn");
  const cards = document.querySelectorAll(".project-card");
  const loadMoreBtn = document.getElementById("projects-load-more");
  const showLessBtn = document.getElementById("projects-show-less");
  const INITIAL_SHOW = 6;
  let currentCategory = "Todos";
  let visibleCount = INITIAL_SHOW;

  // Function to filter and show cards based on category and pagination
  function updateVisibility() {
    let shown = 0;
    let totalFiltered = 0;

    cards.forEach((card) => {
      const cardCategory = card.getAttribute("data-category");
      const matches =
        currentCategory === "Todos" || cardCategory === currentCategory;

      if (matches) {
        totalFiltered++;
        if (shown < visibleCount) {
          card.classList.remove("hidden");
          card.classList.add("animate-fade-in");
          shown++;
        } else {
          card.classList.add("hidden");
          card.classList.remove("animate-fade-in");
        }
      } else {
        card.classList.add("hidden");
        card.classList.remove("animate-fade-in");
      }
    });

    // Handle Buttons Visibility
    if (loadMoreBtn && showLessBtn) {
      if (shown >= totalFiltered) {
        loadMoreBtn.style.display = "none";
      } else {
        loadMoreBtn.style.display = "block";
      }

      if (visibleCount > INITIAL_SHOW) {
        showLessBtn.classList.remove("hidden");
      } else {
        showLessBtn.classList.add("hidden");
      }
    }
  }

  // Initialize
  updateVisibility();

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Update active state
      buttons.forEach((b) => b.setAttribute("data-active", "false"));
      btn.setAttribute("data-active", "true");

      // Update current category and reset pagination
      currentCategory = btn.getAttribute("data-category") || "Todos";
      visibleCount = INITIAL_SHOW;

      updateVisibility();
    });
  });

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener("click", () => {
      visibleCount += 3;
      updateVisibility();
    });
  }

  if (showLessBtn) {
    showLessBtn.addEventListener("click", () => {
      visibleCount = INITIAL_SHOW;
      updateVisibility();

      // Optional: Scroll back to top of grid
      // document.getElementById("projects-grid")?.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

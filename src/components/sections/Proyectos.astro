---
import GitHubIcon from "../icons/GithubIcon.astro";
import LinkButtonIcon from "../ui/LinkButton.astro";
import PlayStoreIcon from "../icons/PlayStore.astro";
import FigmaIcon from "../icons/FigmaIcon.astro";
import BehanceIcon from "../icons/BehanceIcon.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";

import { projectsData } from "../../data/projects";
import { projectCategories } from "../../data/projectCategories";
import { iconMap } from "../../data/iconMap";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/preview/*.webp",
  { eager: true },
);

/** Theme variant path for auto-generated previews (foo.light.webp / foo.dark.webp). */
function previewVariant(
  image: string,
  theme: "light" | "dark",
): ImageMetadata | undefined {
  const variant = image.replace(/\.webp$/, `.${theme}.webp`);
  return images[`/src/assets${variant}`]?.default;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const PROJECTS = projectsData;
const CATEGORIES = projectCategories;

const INITIAL_SHOW = 6;

const categoryKeys: Record<string, string> = {
  Todos: "projects.all",
  App: "categories.app",
  Editorial: "categories.editorial",
  Producto: "categories.producto",
  Videojuegos: "categories.videojuegos",
  Audiovisual: "categories.audiovisual",
  Web: "categories.web",
  Programación: "categories.programacion",
};
---

<div class="flex flex-col items-center gap-y-8 w-full" id="proyectos-section">
  <!-- Category Tabs -->
  <div class="flex flex-wrap justify-center gap-4 mb-8">
    {
      CATEGORIES.map((category) => (
        <button
          class="category-btn px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 border border-gray-600 dark:border-gray-600 bg-transparent text-gray-800 dark:text-white hover:bg-blue-600 hover:text-white hover:border-blue-600 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:border-blue-600"
          data-category={category}
          data-active={category === "Todos"}
        >
          {categoryKeys[category] ? t(categoryKeys[category] as any) : category}
        </button>
      ))
    }
  </div>

  <!-- Projects Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full"
    id="projects-grid"
  >
    {
      PROJECTS.map(
        (
          {
            image,
            title,
            description,
            title_en,
            description_en,
            title_pt,
            description_pt,
            tags,
            category,
            github,
            link,
            link2,
            npm,
            figma,
            behance,
            youtube,
            playstore,
            playstoreComingSoon,
            featured,
            comingSoon,
          },
          index,
        ) => {
          const fallback =
            images[`/src/assets${image}`]?.default ||
            image ||
            "/placeholder-project.jpg";
          const lightSrc = previewVariant(image, "light");
          const darkSrc = previewVariant(image, "dark");
          // Dual-theme only for auto-generated previews (both variants exist).
          // Hand-made mockups keep a single Image — picture+variants broke them.
          const hasThemeVariants = Boolean(lightSrc && darkSrc);
          return (
          <article
            class={`project-card group relative flex flex-col bg-gray-50 dark:bg-gray-900 border rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${featured ? "border-purple-400/60 dark:border-purple-500/40 ring-1 ring-purple-400/30 dark:ring-purple-500/20" : "border-gray-200 dark:border-gray-800"} ${index >= INITIAL_SHOW ? "hidden" : ""}`}
            data-category={
              Array.isArray(category) ? category.join(",") : category
            }
          >
            <div class="relative h-48 overflow-hidden">
              {featured && (
                <span class="absolute top-3 left-3 z-20 inline-flex items-center gap-1 rounded-full bg-purple-600/90 text-white text-[11px] font-semibold px-2.5 py-1 backdrop-blur-sm">
                  ★ {t("projects.featured")}
                </span>
              )}
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300 z-10" />
              {hasThemeVariants && lightSrc && darkSrc ? (
                <>
                  <img
                    src={lightSrc.src}
                    alt={title}
                    class="preview-light object-cover object-center w-full h-full transform transition-transform duration-500 group-hover:scale-110"
                    width={400}
                    height={200}
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    src={darkSrc.src}
                    alt=""
                    aria-hidden="true"
                    class="preview-dark object-cover object-center w-full h-full transform transition-transform duration-500 group-hover:scale-110"
                    width={400}
                    height={200}
                    loading="lazy"
                    decoding="async"
                  />
                </>
              ) : (
                <Image
                  src={fallback}
                  alt={title}
                  class="object-cover object-center w-full h-full transform transition-transform duration-500 group-hover:scale-110"
                  width={400}
                  height={200}
                  widths={[400, 800]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>

            <div class="flex flex-col flex-1 p-6">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
                {lang === "en" && title_en ? title_en : lang === "pt" && title_pt ? title_pt : title}
              </h3>

              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm line-clamp-5 flex-1">
                {lang === "en" && description_en ? description_en : lang === "pt" && description_pt ? description_pt : description}
              </p>

              <div class="flex flex-wrap gap-2 mb-4">
                {tags.map((tag) => {
                  const TagIcon = iconMap[tag.name];
                  return (
                    <span
                      class={`flex items-center gap-x-1.5 rounded-full text-xs font-medium px-2.5 py-1 ${tag.class}`}
                    >
                      {TagIcon && <TagIcon class="size-3.5" aria-hidden="true" />}
                      {tag.name}
                    </span>
                  );
                })}
              </div>

              <footer class="flex flex-wrap items-center gap-2 mt-auto">
                {github &&
                  (Array.isArray(github) ? (
                    github.map((githubUrl, index) => (
                      <LinkButtonIcon href={githubUrl}>
                        <GitHubIcon class="size-4" />
                        {t("projects.code")} {index + 1}
                      </LinkButtonIcon>
                    ))
                  ) : (
                    <LinkButtonIcon href={github}>
                      <GitHubIcon class="size-4" />
                      {t("projects.code")}
                    </LinkButtonIcon>
                  ))}
                {link && (
                  <LinkButtonIcon href={link}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-link size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M9 15l6 -6" />
                      <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                      <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
                    </svg>
                    {t("projects.preview")}
                  </LinkButtonIcon>
                )}
                {npm && (
                  <LinkButtonIcon href={npm}>
                    <span class="text-xs font-bold tracking-tight">npm</span>
                    {t("projects.npm")}
                  </LinkButtonIcon>
                )}
                {playstoreComingSoon && (
                  <button
                    disabled
                    class="inline-flex bg-gray-100 text-gray-400 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-gray-500 dark:bg-gray-800 border dark:border-gray-700 rounded-xl cursor-not-allowed"
                  >
                    <PlayStoreIcon class="size-4" />
                    {t("projects.playstoreSoon")}
                  </button>
                )}
                {playstore && !playstoreComingSoon && (
                  <LinkButtonIcon href={playstore}>
                    <PlayStoreIcon class="size-4" />
                    {t("projects.playstore")}
                  </LinkButtonIcon>
                )}
                {link2 && (
                  <LinkButtonIcon href={link2}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-link size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M9 15l6 -6" />
                      <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                      <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
                    </svg>
                    {t("projects.preview")} 2
                  </LinkButtonIcon>
                )}
                {figma && (
                  <LinkButtonIcon href={figma}>
                    <FigmaIcon class="size-4" />
                    {t("projects.design")}
                  </LinkButtonIcon>
                )}
                {behance && (
                  <LinkButtonIcon href={behance}>
                    <BehanceIcon class="size-4" />
                    {t("projects.design")}
                  </LinkButtonIcon>
                )}
                {youtube && (
                  <LinkButtonIcon href={youtube}>
                    <YoutubeIcon class="size-4" />
                    {t("projects.videos")}
                  </LinkButtonIcon>
                )}
                {comingSoon && !playstoreComingSoon && (
                  <button
                    disabled
                    class="inline-flex bg-gray-100 text-gray-400 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-gray-500 dark:bg-gray-800 border dark:border-gray-700 rounded-xl cursor-not-allowed"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-clock size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                      <path d="M12 7v5l3 3" />
                    </svg>
                    {t("projects.comingSoon")}
                  </button>
                )}
              </footer>
            </div>
          </article>
          );
        },
      )
    }
  </div>

  <div class="mt-4 flex gap-4">
    <button
      id="projects-load-more"
      data-initial-show={INITIAL_SHOW}
      class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      {t("buttons.showMore")}
    </button>
    <button
      id="projects-show-less"
      class="hidden bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      {t("buttons.showLess")}
    </button>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll<HTMLElement>(".category-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    const loadMoreBtn = document.getElementById(
      "projects-load-more"
    ) as HTMLElement | null;
    const showLessBtn = document.getElementById(
      "projects-show-less"
    ) as HTMLElement | null;

    const initialShow = Number(
      loadMoreBtn?.getAttribute("data-initial-show") ?? 6
    );

    let currentCategory = "Todos";
    let visibleCount = initialShow;

    // Function to filter and show cards based on category and pagination
    function updateVisibility(behavior: "instant" | "smooth" = "instant") {
      let shown = 0;
      let totalFiltered = 0;

      cards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        const categories = cardCategory ? cardCategory.split(",") : [];
        const matches =
          currentCategory === "Todos" || categories.includes(currentCategory);

        if (matches) {
          totalFiltered++;
          if (shown < visibleCount) {
            if (card.classList.contains("hidden")) {
              card.classList.remove("hidden");
              card.classList.add("animate-card-in");
            }
            shown++;
          } else {
            if (!card.classList.contains("hidden")) {
              if (behavior === "smooth") {
                card.classList.add("animate-card-out");
                setTimeout(() => {
                  card.classList.add("hidden");
                  card.classList.remove("animate-card-out");
                }, 400);
              } else {
                card.classList.add("hidden");
              }
            }
          }
        } else {
          card.classList.add("hidden");
        }
      });

      // Handle Buttons Visibility
      if (loadMoreBtn && showLessBtn) {
        if (shown >= totalFiltered) {
          loadMoreBtn.style.display = "none";
        } else {
          loadMoreBtn.style.display = "block";
        }

        if (visibleCount > initialShow) {
          showLessBtn.classList.remove("hidden");
        } else {
          showLessBtn.classList.add("hidden");
        }
      }
    }

    // Initialize
    updateVisibility();

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active state
        buttons.forEach((b) => b.setAttribute("data-active", "false"));
        btn.setAttribute("data-active", "true");

        // Update current category and reset pagination
        currentCategory = btn.getAttribute("data-category") || "Todos";
        visibleCount = initialShow;

        updateVisibility("instant");
      });
    });

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        visibleCount += 3;
        updateVisibility("instant");
      });
    }

    if (showLessBtn) {
      showLessBtn.addEventListener("click", () => {
        visibleCount = initialShow;
        updateVisibility("smooth");

        // Scroll back to projects section smoothly
        const proyectosSection = document.getElementById("proyectos-section");
        if (proyectosSection) {
          const yOffset = -100;
          const targetY =
            proyectosSection.getBoundingClientRect().top +
            window.pageYOffset +
            yOffset;
          const startY = window.pageYOffset;
          const distance = targetY - startY;
          const duration = 800;
          let start: number | null = null;

          function easeInOutCubic(t: number) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function step(timestamp: number) {
            if (!start) start = timestamp;
            const progress = Math.min((timestamp - start) / duration, 1);
            window.scrollTo(0, startY + distance * easeInOutCubic(progress));
            if (progress < 1) window.requestAnimationFrame(step);
          }
          window.requestAnimationFrame(step);
        }
      });
    }
  });
</script>

<style>
  .animate-card-in {
    animation: cardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-card-out {
    animation: cardOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  @keyframes cardOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
  }
</style>

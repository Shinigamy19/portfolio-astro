---
import GitHubIcon from "../icons/GithubIcon.astro";
import LinkButtonIcon from "../ui/LinkButton.astro";
import NextJSIcon from "../icons/NextJSIcon.astro";
import TailwindIcon from "../icons/TailwindIcon.astro";
import JavaIcon from "../icons/JavaIcon.astro";
import ProcessingIcon from "../icons/ProcessingIcon.astro";
import PuredataIcon from "../icons/PuredataIcon.astro";
import UnityIcon from "../icons/Unity.astro";
import PhotoshopIcon from "../icons/Photoshop.astro";
import CSharpIcon from "../icons/Csharp.astro";
import PhpIcon from "../icons/Php.astro";
import AfterEffectsIcon from "../icons/Aftereffects.astro";
import AsepriteIcon from "../icons/Asesprite.astro";
import GodotIcon from "../icons/Godot.astro";
import IllustratorIcon from "../icons/Illustrator.astro";
import InDesignIcon from "../icons/Indiseing.astro";
import PremiereIcon from "../icons/Premiere.astro";
import PythonIcon from "../icons/Python.astro";
import WordpressIcon from "../icons/Wordpress.astro";
import MysqlIcon from "../icons/Mysql.astro";
import AuditionIcon from "../icons/Audition.astro";
import BlenderIcon from "../icons/Blender.astro";
import ReaperIcon from "../icons/Reaper.astro";
import UnrealEngineIcon from "../icons/Unrealengine.astro";
import GameMakerIcon from "../icons/Gamemaker.astro";
import CIcon from "../icons/C.astro";
import CPlusPlusIcon from "../icons/Cplusplus.astro";
import FlutterIcon from "../icons/Flutter.astro";
import CanvaIcon from "../icons/Canva.astro";
import DockerIcon from "../icons/Docker.astro";
import FigmaIcon from "../icons/FigmaIcon.astro";
import HtmlIcon from "../icons/Html.astro";
import CssIcon from "../icons/Css.astro";
import JsIcon from "../icons/Js.astro";
import JsonIcon from "../icons/Json.astro";
import GmlIcon from "../icons/Gml.astro";
import ObsstudioIcon from "../icons/Obsstudio.astro";
import CoreldrawIcon from "../icons/Coreldraw.astro";
import KritaIcon from "../icons/Krita.astro";
import GimpIcon from "../icons/Gimp.astro";
import InkscapeIcon from "../icons/Inkscape.astro";
import VisualStudioIcon from "../icons/VisualStudio.astro";
import AndroidstudioIcon from "../icons/Androidstudio.astro";
import AndroidIcon from "../icons/Android.astro";
import MongodbIcon from "../icons/Mongodb.astro";
import DiscordjsIcon from "../icons/Discordjs.astro";
import NodejsIcon from "../icons/Nodejs.astro";
import LaravelIcon from "../icons/Laravel.astro";
import PrismaIcon from "../icons/Prisma.astro";
import P5jsIcon from "../icons/P5js.astro";
import AstroIcon from "../icons/AstroIcon.astro";
import ArduinoIcon from "../icons/Arduino.astro";
import AutocadIcon from "../icons/Autocad.astro";
import WordIcon from "../icons/Word.astro";
import ExcelIcon from "../icons/Excel.astro";
import PowerpointIcon from "../icons/Powerpoint.astro";
import KotlinIcon from "../icons/Kotlin.astro";
import ExpressIcon from "../icons/Express.astro";
import BootstrapIcon from "../icons/Bootstrap.astro";
import JQueryIcon from "../icons/Jquery.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";
import BehanceIcon from "../icons/BehanceIcon.astro";
import BashIcon from "../icons/Bash.astro";
import AngularIcon from "../icons/Angular.astro";
import SassIcon from "../icons/Sass.astro";
import TypescriptIcon from "../icons/Typescript.astro";
import ReactIcon from "../icons/React.astro";

import { projectsData } from "../../data/projects";
import { projectCategories } from "../../data/projectCategories";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/preview/*.webp",
  { eager: true },
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const PROJECTS = projectsData;
const CATEGORIES = projectCategories;

const INITIAL_SHOW = 6;

const categoryKeys: Record<string, string> = {
  Todos: "projects.all",
  Editorial: "categories.editorial",
  Producto: "categories.producto",
  Videojuegos: "categories.videojuegos",
  Audiovisual: "categories.audiovisual",
  Web: "categories.web",
  Programación: "categories.programacion",
};
---

<div class="flex flex-col items-center gap-y-8 w-full" id="proyectos-section">
  <!-- Category Tabs -->
  <div class="flex flex-wrap justify-center gap-4 mb-8">
    {
      CATEGORIES.map((category) => (
        <button
          class="category-btn px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 border border-gray-600 dark:border-gray-600 bg-transparent text-gray-800 dark:text-white hover:bg-blue-600 hover:text-white hover:border-blue-600 data-[active=true]:bg-blue-600 data-[active=true]:text-white data-[active=true]:border-blue-600"
          data-category={category}
          data-active={category === "Todos"}
        >
          {categoryKeys[category] ? t(categoryKeys[category] as any) : category}
        </button>
      ))
    }
  </div>

  <!-- Projects Grid -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full"
    id="projects-grid"
  >
    {
      PROJECTS.map(
        (
          {
            image,
            title,
            description,
            title_en,
            description_en,
            tags,
            category,
            github,
            link,
            link2,
            figma,
            behance,
            youtube,
            comingSoon,
          },
          index,
        ) => (
          <article
            class={`project-card group relative flex flex-col bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${index >= INITIAL_SHOW ? "hidden" : ""}`}
            data-category={
              Array.isArray(category) ? category.join(",") : category
            }
          >
            <div class="relative h-48 overflow-hidden">
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300 z-10" />
              <Image
                src={
                  images[`/src/assets${image}`]?.default ||
                  image ||
                  "/placeholder-project.jpg"
                }
                alt={title}
                class="object-cover object-center w-full h-full transform transition-transform duration-500 group-hover:scale-110"
                width={400}
                height={200}
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="flex flex-col flex-1 p-6">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
                {lang === "en" && title_en ? title_en : title}
              </h3>

              <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm line-clamp-3 flex-1">
                {lang === "en" && description_en ? description_en : description}
              </p>

              <div class="flex flex-wrap gap-2 mb-4">
                {tags.map((tag) => (
                  <span
                    class={`flex items-center gap-x-1.5 rounded-full text-xs font-medium px-2.5 py-1 ${tag.class}`}
                  >
                    {tag.name === "Next.js" && <NextJSIcon class="size-3.5" />}
                    {tag.name === "Tailwind CSS" && (
                      <TailwindIcon class="size-3.5" />
                    )}
                    {tag.name === "Java" && <JavaIcon class="size-3.5" />}
                    {tag.name === "Processing" && (
                      <ProcessingIcon class="size-3.5" />
                    )}
                    {tag.name === "Pure Data" && (
                      <PuredataIcon class="size-3.5" />
                    )}
                    {tag.name === "Unity" && <UnityIcon class="size-3.5" />}
                    {tag.name === "Photoshop" && (
                      <PhotoshopIcon class="size-3.5" />
                    )}
                    {tag.name === "C#" && <CSharpIcon class="size-3.5" />}
                    {tag.name === "PHP" && <PhpIcon class="size-3.5" />}
                    {tag.name === "After Effects" && (
                      <AfterEffectsIcon class="size-3.5" />
                    )}
                    {tag.name === "Aseprite" && (
                      <AsepriteIcon class="size-3.5" />
                    )}
                    {tag.name === "Godot" && <GodotIcon class="size-3.5" />}
                    {tag.name === "Illustrator" && (
                      <IllustratorIcon class="size-3.5" />
                    )}
                    {tag.name === "InDesign" && (
                      <InDesignIcon class="size-3.5" />
                    )}
                    {tag.name === "Premiere Pro" && (
                      <PremiereIcon class="size-3.5" />
                    )}
                    {tag.name === "Python" && <PythonIcon class="size-3.5" />}
                    {tag.name === "WordPress" && (
                      <WordpressIcon class="size-3.5" />
                    )}
                    {tag.name === "MySQL" && <MysqlIcon class="size-3.5" />}
                    {tag.name === "Audition" && (
                      <AuditionIcon class="size-3.5" />
                    )}
                    {tag.name === "Blender" && <BlenderIcon class="size-3.5" />}
                    {tag.name === "Reaper" && <ReaperIcon class="size-3.5" />}
                    {tag.name === "Unreal Engine" && (
                      <UnrealEngineIcon class="size-3.5" />
                    )}
                    {tag.name === "Gamemaker" && (
                      <GameMakerIcon class="size-3.5" />
                    )}
                    {tag.name === "Bootstrap" && (
                      <BootstrapIcon class="size-3.5" />
                    )}
                    {tag.name === "JQuery" && <JQueryIcon class="size-3.5" />}
                    {tag.name === "Bash" && <BashIcon class="size-3.5" />}
                    {tag.name === "C" && <CIcon class="size-3.5" />}
                    {tag.name === "C++" && <CPlusPlusIcon class="size-3.5" />}
                    {tag.name === "Flutter" && <FlutterIcon class="size-3.5" />}
                    {tag.name === "Canva" && <CanvaIcon class="size-3.5" />}
                    {tag.name === "Docker" && <DockerIcon class="size-3.5" />}
                    {tag.name === "Figma" && <FigmaIcon class="size-3.5" />}
                    {tag.name === "HTML5" && <HtmlIcon class="size-3.5" />}
                    {tag.name === "CSS3" && <CssIcon class="size-3.5" />}
                    {tag.name === "JavaScript" && <JsIcon class="size-3.5" />}
                    {tag.name === "JSON" && <JsonIcon class="size-3.5" />}
                    {tag.name === "GML" && <GmlIcon class="size-3.5" />}
                    {tag.name === "OBS Studio" && (
                      <ObsstudioIcon class="size-3.5" />
                    )}
                    {tag.name === "Corel Draw" && (
                      <CoreldrawIcon class="size-3.5" />
                    )}
                    {tag.name === "Krita" && <KritaIcon class="size-3.5" />}
                    {tag.name === "GIMP" && <GimpIcon class="size-3.5" />}
                    {tag.name === "Inkscape" && (
                      <InkscapeIcon class="size-3.5" />
                    )}
                    {tag.name === "Visual Studio" && (
                      <VisualStudioIcon class="size-3.5" />
                    )}
                    {tag.name === "Android Studio" && (
                      <AndroidstudioIcon class="size-3.5" />
                    )}
                    {tag.name === "Android Nativo" && (
                      <AndroidIcon class="size-3.5" />
                    )}
                    {tag.name === "MongoDB" && <MongodbIcon class="size-3.5" />}
                    {tag.name === "Discord.js" && (
                      <DiscordjsIcon class="size-3.5" />
                    )}
                    {tag.name === "Node.js" && <NodejsIcon class="size-3.5" />}
                    {tag.name === "Laravel" && <LaravelIcon class="size-3.5" />}
                    {tag.name === "Prisma" && <PrismaIcon class="size-3.5" />}
                    {tag.name === "p5.js" && <P5jsIcon class="size-3.5" />}
                    {tag.name === "Astro" && <AstroIcon class="size-3.5" />}
                    {tag.name === "Arduino" && <ArduinoIcon class="size-3.5" />}
                    {tag.name === "AutoCAD" && <AutocadIcon class="size-3.5" />}
                    {tag.name === "Word" && <WordIcon class="size-3.5" />}
                    {tag.name === "Excel" && <ExcelIcon class="size-3.5" />}
                    {tag.name === "PowerPoint" && (
                      <PowerpointIcon class="size-3.5" />
                    )}
                    {tag.name === "Kotlin" && <KotlinIcon class="size-3.5" />}
                    {tag.name === "Express.js" && (
                      <ExpressIcon class="size-3.5" />
                    )}
                    {tag.name === "Angular" && <AngularIcon class="size-3.5" />}
                    {tag.name === "Sass" && <SassIcon class="size-3.5" />}
                    {tag.name === "TypeScript" && (
                      <TypescriptIcon class="size-3.5" />
                    )}
                    {(tag.name === "React" || tag.name === "React Native") && <ReactIcon class="size-3.5" />}
                    {tag.name}
                  </span>
                ))}
              </div>

              <footer class="flex flex-wrap items-center gap-2 mt-auto">
                {github &&
                  (Array.isArray(github) ? (
                    github.map((githubUrl, index) => (
                      <LinkButtonIcon href={githubUrl}>
                        <GitHubIcon class="size-4" />
                        {t("projects.code")} {index + 1}
                      </LinkButtonIcon>
                    ))
                  ) : (
                    <LinkButtonIcon href={github}>
                      <GitHubIcon class="size-4" />
                      {t("projects.code")}
                    </LinkButtonIcon>
                  ))}
                {link && (
                  <LinkButtonIcon href={link}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-link size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M9 15l6 -6" />
                      <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                      <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
                    </svg>
                    {t("projects.preview")}
                  </LinkButtonIcon>
                )}
                {link2 && (
                  <LinkButtonIcon href={link2}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-link size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M9 15l6 -6" />
                      <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                      <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
                    </svg>
                    {t("projects.preview")} 2
                  </LinkButtonIcon>
                )}
                {figma && (
                  <LinkButtonIcon href={figma}>
                    <FigmaIcon class="size-4" />
                    {t("projects.design")}
                  </LinkButtonIcon>
                )}
                {behance && (
                  <LinkButtonIcon href={behance}>
                    <BehanceIcon class="size-4" />
                    {t("projects.design")}
                  </LinkButtonIcon>
                )}
                {youtube && (
                  <LinkButtonIcon href={youtube}>
                    <YoutubeIcon class="size-4" />
                    {t("projects.videos")}
                  </LinkButtonIcon>
                )}
                {comingSoon && (
                  <button
                    disabled
                    class="inline-flex bg-gray-100 text-gray-400 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-gray-500 dark:bg-gray-800 border dark:border-gray-700 rounded-xl cursor-not-allowed"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-clock size-4"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                      <path d="M12 7v5l3 3" />
                    </svg>
                    {t("projects.comingSoon")}
                  </button>
                )}
              </footer>
            </div>
          </article>
        ),
      )
    }
  </div>

  <div class="mt-4 flex gap-4">
    <button
      id="projects-load-more"
      class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      {t("buttons.showMore")}
    </button>
    <button
      id="projects-show-less"
      class="hidden bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-6 rounded-full transition-colors duration-300"
    >
      {t("buttons.showLess")}
    </button>
  </div>
</div>

<script is:inline define:vars={{ INITIAL_SHOW }}>
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll(".category-btn");
    const cards = document.querySelectorAll(".project-card");
    const loadMoreBtn = document.getElementById("projects-load-more");
    const showLessBtn = document.getElementById("projects-show-less");

    let currentCategory = "Todos";
    let visibleCount = INITIAL_SHOW;

    // Function to filter and show cards based on category and pagination
    function updateVisibility(behavior = "instant") {
      let shown = 0;
      let totalFiltered = 0;

      cards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        const categories = cardCategory ? cardCategory.split(",") : [];
        const matches =
          currentCategory === "Todos" || categories.includes(currentCategory);

        if (matches) {
          totalFiltered++;
          if (shown < visibleCount) {
            if (card.classList.contains("hidden")) {
              card.classList.remove("hidden");
              card.classList.add("animate-card-in");
            }
            shown++;
          } else {
            if (!card.classList.contains("hidden")) {
              if (behavior === "smooth") {
                card.classList.add("animate-card-out");
                setTimeout(() => {
                  card.classList.add("hidden");
                  card.classList.remove("animate-card-out");
                }, 400);
              } else {
                card.classList.add("hidden");
              }
            }
          }
        } else {
          card.classList.add("hidden");
        }
      });

      // Handle Buttons Visibility
      if (loadMoreBtn && showLessBtn) {
        if (shown >= totalFiltered) {
          loadMoreBtn.style.display = "none";
        } else {
          loadMoreBtn.style.display = "block";
        }

        if (visibleCount > INITIAL_SHOW) {
          showLessBtn.classList.remove("hidden");
        } else {
          showLessBtn.classList.add("hidden");
        }
      }
    }

    // Initialize
    updateVisibility();

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active state
        buttons.forEach((b) => b.setAttribute("data-active", "false"));
        btn.setAttribute("data-active", "true");

        // Update current category and reset pagination
        currentCategory = btn.getAttribute("data-category") || "Todos";
        visibleCount = INITIAL_SHOW;

        updateVisibility("instant");
      });
    });

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        visibleCount += 3;
        updateVisibility("instant");
      });
    }

    if (showLessBtn) {
      showLessBtn.addEventListener("click", () => {
        visibleCount = INITIAL_SHOW;
        updateVisibility("smooth");

        // Scroll back to projects section smoothly
        const proyectosSection = document.getElementById("proyectos-section");
        if (proyectosSection) {
          const yOffset = -100;
          const targetY =
            proyectosSection.getBoundingClientRect().top +
            window.pageYOffset +
            yOffset;
          const startY = window.pageYOffset;
          const distance = targetY - startY;
          const duration = 800;
          let start = null;

          function easeInOutCubic(t) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function step(timestamp) {
            if (!start) start = timestamp;
            const progress = Math.min((timestamp - start) / duration, 1);
            window.scrollTo(0, startY + distance * easeInOutCubic(progress));
            if (progress < 1) window.requestAnimationFrame(step);
          }
          window.requestAnimationFrame(step);
        }
      });
    }
  });
</script>

<style>
  .animate-card-in {
    animation: cardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-card-out {
    animation: cardOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  @keyframes cardOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
  }
</style>

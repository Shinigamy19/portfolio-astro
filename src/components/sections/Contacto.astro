---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import GithubIcon from "../icons/GithubIcon.astro";
import LinkedinIcon from "../icons/LinkedinIcon.astro";
import BehanceIcon from "../icons/BehanceIcon.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";
import TwitchIcon from "../icons/TwitchIcon.astro";
import KickIcon from "../icons/KickIcon.astro";
import DiscordIcon from "../icons/DiscordIcon.astro";
import InstagramIcon from "../icons/InstagramIcon.astro";
import WhatsappIcon from "../icons/WhatsappIcon.astro";
---

<div class="flex flex-col gap-12 w-full max-w-5xl mx-auto">
  <div class="text-center">
    <p class="text-gray-600 dark:text-gray-400 text-lg">
      {
        lang === "es"
          ? "¿Tienes un proyecto en mente? Hablemos sobre cómo puedo ayudarte"
          : "Have a project in mind? Let's talk about how I can help you"
      }
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Contact Form Column -->
    <div class="flex flex-col gap-6">
      <div
        class="bg-white/80 dark:bg-gray-900/30 border border-gray-200 dark:border-gray-800 p-8 rounded-3xl flex-1"
      >
        <form id="contact-form" class="space-y-5">
          <div id="form-status" class="hidden text-center font-medium mb-4">
          </div>

          <div>
            <label
              for="name"
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            >
              {t("contact.name")}
            </label>
            <input
              type="text"
              name="name"
              id="name"
              required
              class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all dark:text-white"
            />
          </div>

          <div>
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            >
              {t("contact.email")}
            </label>
            <input
              type="email"
              name="email"
              id="email"
              required
              pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
              class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all dark:text-white"
            />
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            >
              {t("contact.message")}
            </label>
            <textarea
              name="message"
              id="message"
              rows="4"
              required
              class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all dark:text-white resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all duration-300 transform active:scale-95 disabled:bg-gray-400 disabled:cursor-not-allowed"
          >
            <span id="btn-text">{t("contact.send")}</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Contact Methods Column -->
    <div class="flex flex-col gap-6">
      <!-- Email -->
      <div
        class="bg-white/80 dark:bg-gray-900/30 border border-gray-200 dark:border-gray-800 p-6 rounded-2xl flex items-center gap-6 hover:border-blue-400 dark:hover:border-gray-700 transition-colors"
      >
        <div
          class="bg-blue-100 dark:bg-blue-900/20 p-4 rounded-xl text-blue-600 dark:text-blue-500"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-mail"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"
            ></path>
            <path d="M3 7l9 6l9 -6"></path>
          </svg>
        </div>
        <div>
          <p class="text-gray-500 dark:text-gray-400 font-medium mb-1">Email</p>
          <a
            href="mailto:erosbenitezd@gmail.com"
            class="text-gray-900 dark:text-white text-lg font-semibold hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >erosbenitezd@gmail.com</a
          >
        </div>
      </div>

      <!-- Phone -->
      <div
        class="bg-white/80 dark:bg-gray-900/30 border border-gray-200 dark:border-gray-800 p-6 rounded-2xl flex items-center gap-6 hover:border-blue-400 dark:hover:border-gray-700 transition-colors"
      >
        <div
          class="bg-blue-100 dark:bg-blue-900/20 p-4 rounded-xl text-blue-600 dark:text-blue-500"
        >
          <WhatsappIcon class="size-6" />
        </div>
        <div>
          <p class="text-gray-500 dark:text-gray-400 font-medium mb-1">
            {lang === "es" ? "Teléfono / WhatsApp" : "Phone / WhatsApp"}
          </p>
          <a
            href="https://wa.me/541123977610"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-900 dark:text-white text-lg font-semibold hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            (+54) 11 2397-7610
          </a>
        </div>
      </div>

      <!-- Location -->
      <div
        class="bg-white/80 dark:bg-gray-900/30 border border-gray-200 dark:border-gray-800 p-6 rounded-2xl flex items-center gap-6 hover:border-blue-400 dark:hover:border-gray-700 transition-colors"
      >
        <div
          class="bg-blue-100 dark:bg-blue-900/20 p-4 rounded-xl text-blue-600 dark:text-blue-500"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-map-pin"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
            <path
              d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-gray-500 dark:text-gray-400 font-medium mb-1">
            {lang === "es" ? "Ubicación" : "Location"}
          </p>
          <p class="text-gray-900 dark:text-white text-lg font-semibold">
            Buenos Aires, Argentina
          </p>
        </div>
      </div>

      <!-- Social Media Buttons -->
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://linkedin.com/in/eros-benitez"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="LinkedIn"
        >
          <LinkedinIcon class="size-6" />
        </a>
        <a
          href="https://github.com/shinigamy19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="GitHub"
        >
          <GithubIcon class="size-6" />
        </a>
        <a
          href="https://www.behance.net/shinigamy19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Behance"
        >
          <BehanceIcon class="size-6" />
        </a>
        <a
          href="https://www.youtube.com/c/shinigamy19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Youtube"
        >
          <YoutubeIcon class="size-6" />
        </a>
        <a
          href="https://twitch.tv/shinigamy_19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Twitch"
        >
          <TwitchIcon class="size-6" />
        </a>
        <a
          href="https://kick.com/shinigamy19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Kick"
        >
          <KickIcon class="size-6" />
        </a>
        <a
          href="https://discord.gg/px9fcpbp3T"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Discord"
        >
          <DiscordIcon class="size-6" />
        </a>
        <a
          href="https://www.instagram.com/shinigamy19_art"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Instagram Art"
        >
          <InstagramIcon class="size-6" />
        </a>
        <a
          href="https://www.instagram.com/shinigamy19"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/80 dark:bg-gray-900/50 p-4 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white hover:border-blue-400 dark:hover:border-gray-600 transition-all hover:scale-110"
          aria-label="Instagram Personal"
        >
          <InstagramIcon class="size-6" />
        </a>
      </div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    successMsg: t("contact.success"),
    errorMsg: t("contact.error"),
    emailErrorMsg: t("contact.emailError"),
    sendingMsg: t("contact.sending"),
    sendMsg: t("contact.send"),
    envMailURL: import.meta.env.PUBLIC_FORMSPREE_URL,
  }}
>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    const status = document.getElementById("form-status");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");

    const mailURL = envMailURL || "https://formspree.io/f/xbddjddy";

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const email = formData.get("email");
        const emailRegex = /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/i;

        // Custom email validation
        if (!email || !emailRegex.test(email.toString())) {
          status.innerText = emailErrorMsg;
          status.className = "text-red-600 text-center font-medium mb-4";
          status.classList.remove("hidden");

          // Hide status after 5 seconds
          setTimeout(() => {
            status.classList.add("hidden");
          }, 5000);
          return;
        }

        // Disable button and show loading
        submitBtn.disabled = true;
        btnText.innerText = sendingMsg;
        status.classList.add("hidden");

        try {
          const response = await fetch(mailURL, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json",
            },
          });

          if (response.ok) {
            status.innerText = successMsg;
            status.className = "text-green-600 text-center font-medium mb-4";
            status.classList.remove("hidden");
            form.reset();
          } else {
            throw new Error();
          }
        } catch (err) {
          status.innerText = errorMsg;
          status.className = "text-red-600 text-center font-medium mb-4";
          status.classList.remove("hidden");
        } finally {
          submitBtn.disabled = false;
          btnText.innerText = sendMsg;

          // Hide status after 5 seconds
          setTimeout(() => {
            status.classList.add("hidden");
          }, 5000);
        }
      });
    }
  });
</script>

---
import { skillsData } from "../../data/skills";
import { achievementsData } from "../../data/achievements";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { iconMap } from "../../data/iconMap";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SKILLS = skillsData;
const ACHIEVEMENTS = achievementsData;
---

<div class="flex flex-col gap-10">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      SKILLS.map((skillGroup) => (
        <div class="group bg-white/80 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 transition-all duration-500 hover:-translate-y-2 hover:border-purple-400/50 dark:hover:border-purple-500/50 hover:shadow-2xl hover:shadow-purple-500/20 dark:hover:shadow-purple-500/10 relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 relative z-10 transition-colors group-hover:text-purple-600 dark:group-hover:text-purple-400">
            {lang === "en" && skillGroup.category_en
              ? skillGroup.category_en
              : lang === "pt" && skillGroup.category_pt
              ? skillGroup.category_pt
              : skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-3 relative z-10">
            {skillGroup.items.map((item) => {
              const name = typeof item === "string" ? item : item.name;
              const level = typeof item === "string" ? undefined : item.level;
              const Icon = iconMap[name];
              return (
                <span
                  class="group/skill bg-[#582f82] dark:bg-[#582f82] text-white text-xs font-semibold px-4 py-2 rounded-full shadow-sm hover:shadow-md hover:shadow-purple-500/40 hover:bg-purple-600 dark:hover:bg-purple-500 hover:scale-110 hover:-translate-y-1 transition-all duration-300 cursor-default flex items-center gap-2 relative"
                  title={level !== undefined ? `${name} — ${level}%` : name}
                >
                  {Icon && <Icon class="size-4" aria-hidden="true" />}
                  {name}
                  {level !== undefined && (
                    <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 group-hover/skill:w-full transition-all duration-300 h-0.5 bg-gradient-to-r from-purple-400 to-cyan-400 rounded-full" />
                  )}
                </span>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>

  <div
    class="bg-gradient-to-br from-purple-50 to-blue-50 dark:bg-none dark:bg-[#0f172a] border border-purple-200 dark:border-blue-900/30 rounded-2xl p-8 relative overflow-hidden group"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-purple-100/50 via-transparent to-blue-100/50 dark:from-blue-900/10 dark:via-transparent dark:to-purple-900/10 pointer-events-none group-hover:from-purple-200/60 dark:group-hover:from-blue-900/20 transition-all duration-500"
    >
    </div>
    <h3
      class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center relative z-10"
    >
      {t("skills.achievements")}
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 relative z-10">
      {
        ACHIEVEMENTS.map((achievement) => (
          <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-white dark:hover:bg-white/10 transition-all duration-300 border border-transparent hover:border-purple-300 dark:hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10 hover:-translate-y-1 cursor-default group/item">
            <div class={`shrink-0 mt-1 ${achievement.color} transition-transform duration-300 group-hover/item:scale-110 group-hover/item:rotate-3`}>
              {achievement.icon === "trophy" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-trophy"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 21l8 0" />
                  <path d="M12 17l0 4" />
                  <path d="M7 4l10 0" />
                  <path d="M17 4v8a5 5 0 0 1 -10 0v-8" />
                  <path d="M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                  <path d="M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                </svg>
              )}
              {achievement.icon === "controller" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-device-gamepad-2"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 5h3.5a5 5 0 0 1 0 10h-5.5l-4.015 4.227a2.3 2.3 0 0 1 -3.923 -2.035l1.634 -8.173a5 5 0 0 1 4.904 -4.019h3.4z" />
                  <path d="M14 15l4.07 4.284a2.3 2.3 0 0 0 3.925 -2.023l-1.6 -8.232" />
                  <path d="M8 9v2" />
                  <path d="M7 10h2" />
                  <path d="M14 10h2" />
                </svg>
              )}
              {achievement.icon === "book" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-books"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M5 4m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z" />
                  <path d="M9 4m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z" />
                  <path d="M5 8h4" />
                  <path d="M9 16h4" />
                  <path d="M13.803 4.56l2.184 -.537a1 1 0 0 1 1.215 .733l1.48 5.823a1 1 0 0 1 -.733 1.215l-2.185 .537a1 1 0 0 1 -1.215 -.733l-1.48 -5.823a1 1 0 0 1 .733 -1.215z" />
                  <path d="M14 9l4 -1" />
                </svg>
              )}
              {achievement.icon === "dice" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-dice"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" />
                  <circle cx="8.5" cy="8.5" r=".5" fill="currentColor" />
                  <circle cx="15.5" cy="8.5" r=".5" fill="currentColor" />
                  <circle cx="15.5" cy="15.5" r=".5" fill="currentColor" />
                  <circle cx="8.5" cy="15.5" r=".5" fill="currentColor" />
                </svg>
              )}
            </div>
            <p class="text-gray-700 dark:text-gray-300 text-base leading-relaxed">
              {lang === "en" && achievement.title_en
                ? achievement.title_en
                : lang === "pt" && achievement.title_pt
                ? achievement.title_pt
                : achievement.title}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</div>

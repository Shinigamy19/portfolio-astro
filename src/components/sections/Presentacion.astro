---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const yearsExperience = new Date().getFullYear() - 2017;

const personalImageAlt = "Shinigamy19 Logo";
import { Image } from "astro:assets";
import LogoImage from "../../assets/ui/Logo.webp";
import Badge from "../ui/Badge.astro";
import GithubIcon from "../icons/GithubIcon.astro";
import LinkedinIcon from "../icons/LinkedinIcon.astro";
import BehanceIcon from "../icons/BehanceIcon.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";
import GmailIcon from "../icons/GmailIcon.astro";
import SocialPill from "../ui/SocialPill.astro";
---

<div
  class="max-w-4xl flex flex-col md:flex-row gap-8 items-center md:items-start"
>
  <Image
    class="rounded-full shadow-lg size-32 md:size-40 object-cover"
    src={LogoImage}
    alt={personalImageAlt}
    width={160}
    height={160}
    widths={[160, 320]}
    sizes="(max-width: 768px) 128px, 160px"
    loading="eager"
    decoding="sync"
  />
  <div class="flex flex-col gap-4 flex-1">
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
      {lang === "es" ? "Hola, soy Eros Benitez" : "Hi, I'm Eros Benitez"}
    </h1>
    <a
      href="https://linkedin.com/in/eros-benitez"
      target="_blank"
      rel="noopener"
      class="flex items-center"
    >
      <Badge
        >{
          lang === "es" ? "Disponible para trabajar" : "Available to work"
        }</Badge
      >
    </a>
    <p
      class="text-xl text-gray-800 dark:[&>strong]:text-yellow-400 [&>strong]:text-sky-600 [&>strong]:font-semibold dark:text-gray-300"
    >
      {
        lang === "es" ? (
          <>
            <strong>
              Diseñador Multimedia, Fullstack Developer y Creador de Contenido.
            </strong>
            <br />
            Mi nombre es Eros Douglas Benitez Dos Santos.
            <br />
            Pero todos me conocen como <strong>Shinigamy19</strong>.
            <br />Y cuento con{" "}
            <strong>+{yearsExperience} años de experiencia.</strong>
          </>
        ) : (
          <>
            <strong>
              Multimedia Designer, Fullstack Developer, and Content Creator.
            </strong>
            <br />
            My name is Eros Douglas Benitez Dos Santos.
            <br />
            But everyone knows me as <strong>Shinigamy19</strong>.
            <br />
            And I have <strong>+{yearsExperience} years of experience.</strong>
          </>
        )
      }
    </p>
    <nav class="flex flex-wrap gap-4 mt-2">
      <SocialPill href="https://linkedin.com/in/eros-benitez">
        <LinkedinIcon class="size-6" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/shinigamy19">
        <GithubIcon class="size-6" />
        GitHub
      </SocialPill>
      <SocialPill href="https://www.behance.net/shinigamy19">
        <BehanceIcon class="size-6" />
        Behance
      </SocialPill>
      <SocialPill href="https://www.youtube.com/c/shinigamy19">
        <YoutubeIcon class="size-6" />
        Youtube
      </SocialPill>
      <SocialPill href="mailto:erosbenitezd@gmail.com">
        <GmailIcon class="size-6" />
        Gmail
      </SocialPill>
    </nav>

    <div class="flex flex-wrap gap-3 mt-4">
      <a
        href="https://drive.google.com/file/d/1TIUZJs-neV9UO_23fVsuclZ_1-fu3RTE/view?usp=sharing"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
          <path d="M7 11l5 5l5 -5"></path>
          <path d="M12 4l0 12"></path>
        </svg>
        CV Harvard
      </a>
      <a
        href="https://drive.google.com/file/d/16d4Muz5K7q9dLgGe3ull3-tF-h0H3y7M/view?usp=sharing"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
          <path d="M7 11l5 5l5 -5"></path>
          <path d="M12 4l0 12"></path>
        </svg>
        CV Oxford
      </a>
    </div>
  </div>
</div>
